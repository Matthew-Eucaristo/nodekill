# Record with: vhs demo/demo.tape   (run from the repository root)
# Afterwards: hdiutil detach /tmp/nodekill-demo/home; rm -rf /tmp/nodekill-demo
Output demo/demo.gif
Set Shell bash
Set FontSize 15
Set Width 1280
Set Height 640
Set Padding 16
Set TypingSpeed 60ms

Hide
Type "source demo/setup.sh && clear" Enter
Sleep 40s
Type "clear" Enter
Sleep 500ms
Show

Type "nodekill --dry-run" Sleep 400ms Enter
Sleep 4s
Down Sleep 700ms
Down Sleep 700ms
Down Sleep 700ms
Type "s" Sleep 1.5s
Tab Sleep 1.8s
Tab Sleep 1.8s
Tab Sleep 500ms
Type "G" Sleep 2s
Up Sleep 600ms
Up Sleep 600ms
Up Sleep 600ms
Type "a" Sleep 1.5s
Enter Sleep 3s
Type "y" Sleep 3s
Type "?" Sleep 3s
Type "x" Sleep 500ms
Type "q" Sleep 3s
